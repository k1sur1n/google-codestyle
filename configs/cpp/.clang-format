---
# =============================================================================
# Профиль Google · C++ · .clang-format
# Данные актуальны на 2026-10-09. Правила: ../../docs/languages/cpp.md (G-CPP-001…G-CPP-073).
#
# Как пользоваться: скопируйте файл в корень репозитория под именем .clang-format.
# Источник истины - текст Google C++ Style Guide (редакция 2026-09-29,
# https://google.github.io/styleguide/cppguide.html); этот файл - приближение к нему.
#
# Версии:
#   clang-format 18.1.3 - проверено локально (см. ниже).
#   clang-format 21.1-23.1 - не запускалось (в среде сборки установлена только 18.1.3);
#   все опции файла существуют с версии 15 и раньше, новых опций 19+ здесь нет.
#
# Проверено локально (2026-10-09, clang-format 18.1.3):
#   - `clang-format --style=file:<этот файл> --dump-config` - без ошибок;
#   - образец с `int *p`, `const std::string &s`, перепутанным порядком #include и строкой
#     длиннее 80 символов переформатирован в `int* p`, `const std::string& s`, группы
#     include «связанный заголовок / <*.h> / <stdlib> / остальные», перенос на 80 колонках;
#   - `clang-format --dry-run -Werror` на отформатированном образце возвращает 0.
#
# Закрепите ОДНУ версию clang-format для всех разработчиков и CI: вывод разных версий
# различается в мелочах даже при одинаковом конфиге.
# =============================================================================
Language: Cpp

# Пресет LLVM «Follows Google's C++ style guide»: 80 колонок, отступ 2 пробела, без табов,
# перенос с отступом 4, `public:` с отступом 1, содержимое namespace без отступа,
# перегруппировка #include (IncludeBlocks: Regroup), комментарий `}  // namespace foo`.
# Так же (только эти две строки) настроены abseil-cpp и googletest.
BasedOnStyle: Google

# G-CPP-004. Гайд с 2025-07-31 требует `char* c`, `const std::string& s` без вариантов.
# В пресете Google до clang-format 20 включительно стоит DerivePointerAlignment: true
# (форматтер подражает преобладающему в файле стилю, в том числе `int *p`); с 21.1.0 - false.
# Явная запись делает результат одинаковым на любой версии.
DerivePointerAlignment: false
PointerAlignment: Left

# G-CPP-073. Гайд целится в C++20; в пресете стоит Standard: Auto (угадывание по файлу).
Standard: c++20

# --- Необязательные усиления (по умолчанию выключены) ------------------------
#
# 1. G-CPP-005. Гайд с 2026-05-07 разрешает, но не поощряет однострочные if/циклы без
#    фигурных скобок. Пресет их сохраняет и сам сворачивает `if (x) return;` в одну строку.
#    Для нового кода раскомментируйте три строки ниже (InsertBraces есть с clang-format 15;
#    опция меняет токены, а не только пробелы, - просмотрите первый дифф глазами):
#
# AllowShortIfStatementsOnASingleLine: Never
# AllowShortLoopsOnASingleLine: false
# InsertBraces: true
#
# 2. G-CPP-022. Гайд перечисляет пять групп #include, пресет - три: «чужие библиотеки» и
#    «заголовки проекта» сливаются в один блок (в примере самого гайда они тоже идут одним
#    блоком). Чтобы отделить заголовки проекта, раскомментируйте блок и замените `myproject`
#    на каталог(и) своего проекта через `|`. Первые три записи и последняя повторяют пресет.
#
# IncludeCategories:
#   - Regex: '^<ext/.*\.h>'
#     Priority: 2
#   - Regex: '^<.*\.h>'
#     Priority: 1
#   - Regex: '^<.*'
#     Priority: 2
#   - Regex: '^"(myproject)/'
#     Priority: 4
#   - Regex: '.*'
#     Priority: 3
...
